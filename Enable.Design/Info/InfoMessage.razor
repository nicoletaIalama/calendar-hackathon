@inject IJSRuntime JS
@implements IAsyncDisposable

<eds-info-message @ref="_infoMessage"
                  status="@StatusTypeToString(Status)"
                  display="@DisplayTypeToString(Display)"
                  message="@Message"
                  actionText="@ActionText">
</eds-info-message>

@code {
    private ElementReference? _infoMessage;
    private DotNetObjectReference<InfoMessage>? _self;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired] public string Message { get; set; } = default!;
    [Parameter] public StatusType Status { get; set; } = StatusType.Info;
    [Parameter] public DisplayType Display { get; set; } = DisplayType.Inline;
    [Parameter] public string ActionText { get; set; } = string.Empty;
    [Parameter] public EventCallback ActionClick { get; set; }

    public enum StatusType
    {
        Info,
        Warning,
        Success,
        Error
    }

    public enum DisplayType
    {
        Inline,
        Block
    }

    protected override void OnInitialized()
    {
        _self = DotNetObjectReference.Create(this);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await GetModule();
            await _module.InvokeVoidAsync("initInfoMessage", _infoMessage, _self);
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
    
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
    
    private async Task<IJSObjectReference> GetModule()
    {
        return _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Enable.Design/Info/InfoMessage.razor.js");
    }

    [JSInvokable]
    public async Task OnActionClicked()
    {
        await ActionClick.InvokeAsync();
    }

    private static string StatusTypeToString(StatusType statusType)
    {
        switch (statusType)
        {
            case StatusType.Warning:
                return "warning";
            case StatusType.Success:
                return "success";
            case StatusType.Error:
                return "error";
            default:
            case StatusType.Info:
                return "info";
        }
    }

    private static string DisplayTypeToString(DisplayType displayType)
    {
        switch (displayType)
        {
            case DisplayType.Block:
                return "block";
            default:
            case DisplayType.Inline:
                return "inline";
        }
    }
}