@using System.Linq.Expressions
@using Enable.Design.Grids.Shared
@using GridStrings = Enable.Design.Languages.Design.GridStrings

@typeparam TGridItem
@attribute [CascadingTypeParameter(nameof(TGridItem))]

<CascadingValue IsFixed="true" Value="this">
    @Columns

    <Defer>
        @if (BulkActions is not null || Actions is not null)
        {
            <div class="grid-action-bar">
                @if (BulkActions is not null)
                {
                    <div class="grid-bulk-actions @(ApplyFullWidthToActionDivs ? "w-full" : string.Empty)">
                        @if (SelectedItems.Count != 1)
                        {
                            <p>@string.Format(GridStrings.Number_ItemsSelected, SelectedItems.Count)</p>

                        }
                        else
                        {
                            <p>@string.Format(GridStrings.SingleItemSelected, SelectedItems.Count)</p>
                        }
                        @BulkActions(SelectedItems)

                    </div> 
                }

                @if (Actions is not null)
                {
                    <div class="grid-actions">
                        @Actions
                    </div>
                }
            </div>
        }

        <div>
            <table class="@TableClass" aria-rowcount="@(_gridItemsProvider?.PageSize + 1 ?? 0)">
                <thead>
                <tr>
                    @if (SelectableRows)
                    {
                        <td class="check w-6">
                            <input type="checkbox"
                                   aria-label="@GridStrings.SelectAll"
                                   checked="@(_gridItemsProvider?.Page.All(x => SelectedItems.Contains(x)))"
                                   @onchange="HandleToggledAllRows">
                        </td>
                    }
                    @foreach (var column in RegisteredColumns)
                    {
                        @column.HeaderTemplate
                    }
                    @if (OnDelete.HasDelegate)
                    {
                        <td class="w-16 @HeaderCellClass"></td>
                    }
                </tr>
                </thead>
                <tbody class="@(OnRowClick.HasDelegate || SelectableRows ? "clickable" : "")">
                @if (_gridItemsProvider is not null)
                {
                    for (var i = 0; i < _gridItemsProvider.Page.Count; i++)
                    {
                        // This null access is fine because we ensure we are only iterating in the bounds of the List.
                        var item = _gridItemsProvider.Page[i]!;
                        if (GroupBy is not null)
                        {
                            var group = GroupBy(_gridItemsProvider.Page[i]);
                            if (i == 0 || group != GroupBy(_gridItemsProvider.Page[i - 1]))
                            {
                                <GroupHeader @key="group.GetHashCode()"
                                             Group="@group"
                                             GroupCount="GetGroupCount(group)"
                                             FirstRow="item"
                                             Open="GroupOpen(group)"
                                             OpenChanged="(o) => SetGroupOpen(group, o)"/>
                            }
                        }

                        <GridRow @key="item.GetHashCode()"
                                 RowHasClick="OnRowClick.HasDelegate"
                                 Item="item"
                                 Selected="SelectedItems.Contains(item)"
                                 HideRow="IsRowHidden(item)"
                                 RowIndex="@CalculateRowIndex(i + 1)"/>
                    }
                }
                </tbody>
            </table>

            @if (_gridItemsProvider is null)
            {
                @if (Loading is not null)
                {
                    @Loading
                }
                else
                {
                    <p>@GridStrings.Loading</p>
                }
            }
            else
            {
                @if (!_gridItemsProvider.HasItems)
                {
                    <p>@NoItemsText</p>
                }
            }
        </div>
        @if (_gridItemsProvider is not null)
        {
            <CascadingValue Value="_gridItemsProvider!">
                <Paginator TGridItem="TGridItem" OnChange="StateHasChanged"/>
            </CascadingValue>
        }
    </Defer>
</CascadingValue>

@code {
    private GridItemsProvider<TGridItem>? _gridItemsProvider;
    private HashSet<string> _hiddenGroups = new();

    private int TotalItems => _gridItemsProvider?.TotalItems ?? 0;

    public string RowClass = "";
    public string HeaderCellClass = "";
    public string BodyCellClass = "";

    internal readonly List<Column<TGridItem>> RegisteredColumns = new();
    internal Column<TGridItem>? CurrentlySortedColumn;

    [Parameter] public List<TGridItem> SelectedItems { get; set; } = new();
    [Parameter] public EventCallback<List<TGridItem>> SelectedItemsChanged { get; set; }
    [Parameter, EditorRequired] public ICollection<TGridItem> Items { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment Columns { get; set; } = default!;
    [Parameter] public RenderFragment<TGridItem>? GroupTemplate { get; set; }
    [Parameter] public RenderFragment? Loading { get; set; }
    [Parameter] public RenderFragment<IReadOnlyList<TGridItem>>? BulkActions { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string NoItemsText { get; set; } = GridStrings.NoItems;

    [Parameter] public bool Sortable { get; set; }
    [Parameter] public bool SelectableRows { get; set; }
    [Parameter] public EventCallback<TGridItem> OnRowClick { get; set; }
    [Parameter] public EventCallback<TGridItem> OnDelete { get; set; }
    [Parameter] public Func<TGridItem, bool>? OnDeleteCondition { get; set; }
    [Parameter] public bool DisableRowClick { get; set; }
    [Parameter] public Func<TGridItem, string>? GroupBy { get; set; }

    [Parameter] public string TableClass { get; set; } = "";
    [Parameter] public bool ApplyFullWidthToActionDivs { get; set; }

    protected override void OnInitialized()
    {
        _hiddenGroups = new();
        _gridItemsProvider = new GridItemsProvider<TGridItem>(Items.ToList(), GroupBy);
    }

    protected override void OnParametersSet()
    {
        _gridItemsProvider?.SetItems(Items.ToList());
    }

    private void HandleToggledAllRows()
    {
        SelectedItems = Items.All(i => SelectedItems.Contains(i)) ? SelectedItems.Except(Items).ToList() : SelectedItems.Union(Items).ToList();
        if (SelectedItemsChanged.HasDelegate)
        {
            SelectedItemsChanged.InvokeAsync(SelectedItems);
        }

        StateHasChanged();
    }

    private int CalculateRowIndex(int loopIndex)
    {
        if (_gridItemsProvider is null)
        {
            return loopIndex;
        }

        var pageIndex = _gridItemsProvider.PageIndex;

        if (pageIndex == 1)
        {
            return loopIndex;
        }

        if (pageIndex > 1)
        {
            return ((pageIndex - 1) * _gridItemsProvider.PageSize) + loopIndex;
        }

        return loopIndex;
    }

    public void AddSelectedItem(TGridItem item)
    {
        SelectedItems.Add(item);
        SelectedItemsChanged.InvokeAsync(SelectedItems);
        StateHasChanged();
    }

    public void RemoveSelectedItem(TGridItem item)
    {
        SelectedItems.Remove(item);
        SelectedItemsChanged.InvokeAsync(SelectedItems);
        StateHasChanged();
    }

    private bool GroupOpen(string group)
        => !_hiddenGroups.Contains(group);

    private void SetGroupOpen(string group, bool open)
    {
        _ = open ? _hiddenGroups.Remove(group) : _hiddenGroups.Add(group);
        StateHasChanged();
    }

    private bool IsRowHidden(TGridItem row)
        => GroupBy is not null && _hiddenGroups.Contains(GroupBy(row));

    internal void AddColumn(Column<TGridItem> column)
        => RegisteredColumns.Add(column);

    internal void SortByField(Expression<Func<TGridItem, object>> field, SortOrder sortDirection, Column<TGridItem> sortedColumn)
    {
        _gridItemsProvider?.SetOrder(field.Compile(), sortDirection);
        foreach (var column in RegisteredColumns.Where(x => x != sortedColumn))
        {
            column.ClearSortDirection();
        }

        CurrentlySortedColumn = sortedColumn;
        StateHasChanged();
    }

    private int GetGroupCount(string group)
        => GroupBy is null ? 0 : _gridItemsProvider!.Page.Count(x => GroupBy(x) == group);

}