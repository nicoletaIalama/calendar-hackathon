<div class="workflow-details__container @(_expandedView ? "expanded" : "")">
    <div class="workflow-details__users-list">
        <div class="heading">
            <h3>Users in group</h3>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="#5A6F72"
                class="expand-icon"
                @onclick="ExpandView">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/>
            </svg>
        </div>
        <ul class="users-list">
            @foreach (var user in StepUsers)
            {
                <li class="users-list__user">
                    @GetStatusSvg(user)
                    <span class="user__name">@(user.Name)</span>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<WorkflowStepUser> StepUsers { get; set; } = default!;
    private bool _expandedView = false;

    private void ExpandView()
    {
        _expandedView = !_expandedView;
    }

    private MarkupString GetStatusSvg(WorkflowStepUser user)
    {
        switch (user.ApprovalState)
        {
            case WorkflowStepUserApprovalState.Pending:
                return new MarkupString(@"<div class='sign-off'>
                                              <svg
                                                  xmlns='http://www.w3.org/2000/svg'
                                                  fill='none'
                                                  viewBox='0 0 24 24'
                                                  stroke-width='2'
                                                  stroke='#82999C'
                                                  class='w-6 h-6'>
                                                  <path
                                                      stroke-linecap='round'
                                                      stroke-linejoin='round'
                                                      d='M6.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0zM12.75 12a.75.75 0
                                                      11-1.5 0 .75.75 0 011.5 0zM18.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0z'/>
                                              </svg>
                                          </div>");
            case WorkflowStepUserApprovalState.SignedOff:
                return new MarkupString(@"<div class='sign-off sign-off--success'>
                                             <svg
                                                 xmlns='http://www.w3.org/2000/svg'
                                                 fill='none'
                                                 viewBox='0 0 24 24'
                                                 stroke-width='2'
                                                 stroke='#34B233'
                                                 width='1.5rem'>
                                                 <path
                                                     stroke-linecap='round'
                                                     stroke-linejoin='round'
                                                     d='M4.5 12.75l6 6 9-13.5'/>
                                             </svg>
                                         </div>");
            case WorkflowStepUserApprovalState.Queried:
                return new MarkupString(@"<div class='sign-off sign-off--queried'>
                                             <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' 
                                                stroke-width='1.5' stroke='#FF7900'>
                                                <path stroke-linecap='round' stroke-linejoin='round' d='M9.879 7.519c1.171-1.025 
                                                3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 
                                                1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z' />
                                             </svg>
                                         </div>");
            default:
                return new MarkupString("");
        }
    }

}