@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<eds-toast @ref="_toast"
           status="@Status.ToString().ToLower()"
           display="block"
           message="@Message"
           displaytimer="0"
           headline="@Status.ToString()">
</eds-toast>

@code {
    [CascadingParameter] public BlazoredToast ToastInstance { get; set; } = default!;

    [Parameter, EditorRequired] public ToastStatus Status { get; set; }

    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    private IJSObjectReference? _module;
    private ElementReference? _toast;
    private DotNetObjectReference<Toast>? _self;

    public enum ToastStatus
    {
        Info,
        Warning,
        Success,
        Error
    }
    
    protected override void OnInitialized()
    {
        _self = DotNetObjectReference.Create(this);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await GetModule();
            await module.InvokeVoidAsync("initToastComponent", _toast, _self);
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
    
    [JSInvokable]
    public void OnDismissButtonClicked()
    {
        Dismiss();
    }
    
    private void Dismiss()
    {
        ToastInstance.Close();
    }
    
    private async Task<IJSObjectReference> GetModule()
    {
        if (_module is null)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Enable.Design/Toast/Toast.razor.js");
        }

        return _module;
    }
}