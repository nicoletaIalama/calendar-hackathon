@inject IJSRuntime JsRuntime

<eds-accordion 
    id="eds-accordion-web-default" 
    headingsize="@GetHeadingSize()" 
    open="@(Open ? "true" : "false")" 
    disabled="@(Disabled ? "true" : "false")"
    @onkeydown="HandleModalAccordionNavigation">
    <div slot="header">
        @HeaderContent
    </div>
    <div slot="content">
        @ChildContent
    </div>
</eds-accordion>

@code {
    [Parameter, EditorRequired] public bool Open { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public AccordionHeadingSize HeadingSize { get; set; } = AccordionHeadingSize.Medium;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    
    private IJSObjectReference? _module;

    public enum AccordionHeadingSize
    {
        Large,
        Medium,
        Small
    }

    protected override async Task OnParametersSetAsync()
    {
        await GetModule();
    }

    private string GetHeadingSize()
    {
        switch (HeadingSize)
        {
            case AccordionHeadingSize.Large:
                return "large";
            case AccordionHeadingSize.Medium:
                return "medium";
            case AccordionHeadingSize.Small:
                return "small";
        }

        return string.Empty;
    }
    
    private async Task GetModule()
    {
        if (_module is null)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Enable.Design/Accordion/Accordion.razor.js");
        }
    }
    
    private void HandleModalAccordionNavigation(KeyboardEventArgs args)
    {
        if (args.Key is "ArrowDown" or "ArrowUp")
        {
            _module!.InvokeVoidAsync("handleAccordionNavigation", args.Key);
        }
    }
}