<div class="flex items-center justify-center rounded-full @CalculateStyle() @CalculateSize()">
    @Text
</div>

@code {
    [Parameter, EditorRequired] public required string Text { get; set; }
    [Parameter, EditorRequired] public required FdsAvatarStyle Style { get; set; }
    [Parameter, EditorRequired] public required FdsAvatarSize Size { get; set; }
    
    private string CalculateStyle()
    {
        return Style switch
        {
            FdsAvatarStyle.Light => "bg-steel-30 text-blue-70",
            FdsAvatarStyle.Inverse => "bg-blue-80 text-white",
            _ => ""
        };
    }
    
    private string CalculateSize()
    {
        return Size switch
        {
            FdsAvatarSize.XxSmall => "w-[16px] h-[16px] text-[10px]",
            FdsAvatarSize.XSmall => "w-[20px] h-[20px] text-[12px]",
            FdsAvatarSize.Small => "w-[24px] h-[24px] text-[14px]",
            FdsAvatarSize.Medium => "w-[32px] h-[32px] text-[16px]",
            FdsAvatarSize.Large => "w-[40px] h-[40px]",
            FdsAvatarSize.XLarge => "w-[48px] h-[48px]",
            FdsAvatarSize.XxLarge => "w-[64px] h-[64px]",
            _ => ""
        };
    }
}