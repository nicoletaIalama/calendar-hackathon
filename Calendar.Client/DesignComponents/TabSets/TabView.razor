@if (TabSet.SelectedTab == this)
{
    @ChildContent
}

@code {
    [CascadingParameter] public required TabSet TabSet { get; set; }

    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }

    protected override void OnInitialized() => TabSet.AddTabView(this);
}