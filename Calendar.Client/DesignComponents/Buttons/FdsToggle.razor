@using Calendar.Client.DesignComponents.Icons

<div class="flex items-center gap-2 select-none">
    <div
        tabindex="0"
        class="relative flex items-center w-14 h-7 rounded-full transition-colors duration-200 cursor-pointer border-2 border-steel-30 bg-steel-10 @(IsActive ? "bg-green-60 border-green-60" : "") @(Disabled ? "opacity-50 pointer-events-none" : "")"
        role="switch"
        aria-checked="@IsActive.ToString().ToLower()"
        @onclick="ToggleState"
        @onkeydown="HandleKeyPress">
        <div class="absolute transition-transform duration-200"
             style="@(IsActive ? "transform: translateX(1.6rem);" : "transform: translateX(-0.1rem);")">
            <div class="w-7 h-7 rounded-full flex items-center justify-center transition-colors duration-200 @(IsActive ? "bg-green-60" : "bg-white border border-steel-30")">
                @if (IsActive)
                {
                    <FdsCheckIcon Class="text-white" SizeClass="w-6 h-6" />
                }
                else
                {
                    <FdsCloseIcon Class="text-green-60" SizeClass="w-6 h-6" />
                }
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="cursor-pointer text-colour-text-base @(Disabled ? "text-colour-text-disabled-default" : "")" @onclick="ToggleState">@Label</label>
    }
</div>

@code {
    [Parameter] public required bool IsActive { get; set; }
    [Parameter] public EventCallback<bool> IsActiveChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task ToggleState()
    {
        if (!Disabled)
        {
            await IsActiveChanged.InvokeAsync(!IsActive);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (Disabled) return;
        if (e.Key == " " || e.Key == "Enter")
        {
            await ToggleState();
        }
    }
} 