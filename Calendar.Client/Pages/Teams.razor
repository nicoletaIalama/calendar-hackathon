@page "/teams"
@inject EmployeeApiClient EmployeesApi
@using global::Calendar.Client.Components
@using Calendar.Client.DesignComponents.Tags

<div class="py-6">
    <div class="mb-6">
        <h1 class="eds-h1 mb-2">Teams</h1>
        <p class="text-steel-60 font-body-md">Create and manage employee teams for your calendar views</p>
    </div>

    @if (_selectedEmployees.Count > 0)
    {
        <div class="mb-5">
            <div class="bg-green-10 border border-green-30 rounded-lg p-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <div class="font-body-md-semibold text-green-70 mb-1">Team Summary</div>
                        <div class="font-body-sm text-steel-70">
                            <span class="fw-semibold">@_selectedEmployees.Count</span> 
                            @(_selectedEmployees.Count == 1 ? "employee" : "employees") selected
                            @if (_selectedEmployees.Count(e => !e.IsActive) > 0)
                            {
                                <span class="ms-2">
                                    • <span class="fw-semibold">@_selectedEmployees.Count(e => !e.IsActive)</span> inactive
                                </span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="badge bg-green-50 text-white px-3 py-2 rounded-pill font-body-sm">
                            @_selectedEmployees.Count(e => e.IsActive) active
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="bg-white border border-steel-20 rounded-xl p-5 shadow-sm h-100">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="bg-blue-10 rounded-lg p-2">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 9C11.6569 9 13 7.65685 13 6C13 4.34315 11.6569 3 10 3C8.34315 3 7 4.34315 7 6C7 7.65685 8.34315 9 10 9Z" stroke="var(--brand-blue-70)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M3 17C3 13.6863 5.68629 11 9 11H11C14.3137 11 17 13.6863 17 17" stroke="var(--brand-blue-70)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h2 class="eds-h2 mb-0 font-body-md-semibold" style="font-size: 1.25rem;">Pick Employees</h2>
                </div>

                <EmployeePicker SelectedEmployeeIds="@_selectedIds"
                                SelectedEmployeeIdsChanged="@OnSelectedIdsChanged" />
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="bg-white border border-steel-20 rounded-xl p-5 shadow-sm h-100">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="bg-green-10 rounded-lg p-2">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16.6667 5L7.50004 14.1667L3.33337 10" stroke="var(--brand-green-60)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h2 class="eds-h2 mb-0 font-body-md-semibold" style="font-size: 1.25rem;">Selected Team</h2>
                </div>

                @if (_selectedEmployees.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="opacity-50">
                                <circle cx="32" cy="20" r="8" stroke="var(--brand-steel-40)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M16 52C16 44 22 38 32 38C42 38 48 44 48 52" stroke="var(--brand-steel-40)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="font-body-md-semibold text-steel-60 mb-1">No employees selected</div>
                        <div class="font-body-sm text-steel-50">Select employees from the picker to build your team</div>
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @foreach (var e in _selectedEmployees.OrderBy(e => e.LastName).ThenBy(e => e.FirstName))
                            {
                                <div class="position-relative">
                                    <FdsTag Text="@e.DisplayName" Style="FdsTagStyle.NeutralLight" />
                                    @if (!e.IsActive)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark" style="font-size: 0.5rem; padding: 0.15rem 0.25rem;">
                                            !
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="border-top border-steel-20 pt-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="font-body-sm-semibold text-steel-70">Team Details</span>
                                <span class="badge bg-steel-10 text-steel-70 px-2 py-1 rounded font-body-xs">
                                    @_selectedEmployees.Count members
                                </span>
                            </div>
                            <div class="font-body-xs text-steel-50 mt-2" style="word-break: break-all;">
                                <span class="fw-semibold">IDs:</span> @string.Join(", ", _selectedEmployees.Select(x => x.Id))
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private HashSet<int> _selectedIds = new();
    private readonly List<EmployeeDto> _selectedEmployees = new();

    private async Task OnSelectedIdsChanged(HashSet<int> ids)
    {
        _selectedIds = ids;

        // Ensure we have full employee info for the sidebar. For now, just refetch and join locally.
        var all = await EmployeesApi.GetEmployeesAsync(query: null);
        _selectedEmployees.Clear();
        _selectedEmployees.AddRange(all.Where(e => _selectedIds.Contains(e.Id)));
    }
}


