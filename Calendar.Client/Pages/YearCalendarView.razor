@page "/views/calendar"
@using Calendar.Client.Components.Layout
@inject EmployeeHolidayApiClient EmployeeHolidayApi
@inject EmployeeApiClient EmployeeApi
@using Enable.Design.Forms

<div class="py-4">
    <h1 class="eds-h1 mb-4">Calendar Year View</h1>

    <AutoFillSearch
        @ref="_employeeSearch"
        Items="_searchResults"
        IsMultiSelect="false"
        ShowViewMore="false"
        SearchTermChanged="SearchEmployees"
        SingleItemSelected="OnEmployeeSelected"
        PlaceholderText="Select employeee to view">
    </AutoFillSearch>

    @if (!string.IsNullOrEmpty(SelectedEmployeeInitials)) {}
        <YearCalendar EmployeeInitials="@(SelectedEmployeeInitials)" />
    }
</div>

@code {
    private readonly List<EmployeeDto> _employees = new();
    private AutoFillSearch.DropdownItem[] _searchResults = [];
    private string? SelectedEmployeeInitials { get; set; } = ""; // Default or null
    private AutoFillSearch? _employeeSearch;

    protected async Task SearchEmployees(string? searchTerm = "")
    {
        _employees.Clear();
        _employees.AddRange(await EmployeeApi.GetEmployeesAsync(searchTerm));

        _searchResults = _employees.Select(e => new AutoFillSearch.DropdownItem(e.Initials, $"{e.FirstName} {e.LastName} ({e.Initials})")).ToArray();
    }

    private void OnEmployeeSelected(AutoFillSearch.DropdownItem employee)
    {
        SelectedEmployeeInitials = employee.Id;
    }

    protected override async Task OnInitializedAsync()
    {
        await SearchEmployees();
    }
}