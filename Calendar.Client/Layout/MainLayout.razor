@inherits LayoutComponentBase
@using Enable.Design.Layout

<div class="min-vh-100 d-flex flex-column">
    <Navigation NavigationLinks="@_navigationLinks" 
                EnableAppsUrl="/" 
                Breadcrumbs="@_breadcrumbs" 
                CurrentArea="@_currentArea" />

    <main class="flex-grow-1 p-4">
        <div class="container-fluid">
            @Body
        </div>
    </main>
</div>

@code {
    private readonly List<NavigationLink> _navigationLinks = new()
    {
        new NavigationLink("Home", "/"),
        new NavigationLink("Teams", "/teams"),
        new NavigationLink("Team Holidays View", "/views/team"),
        new NavigationLink("Calendar Year View", "/views/calendar")
    };

    private readonly List<NavigationLink> _breadcrumbs = new();
    private string? _currentArea = null;
}


