@inject EmployeeApiClient EmployeesApi
@inject EmployeeViewsStore ViewsStore
@inject IJSRuntime Js

<div class="vstack gap-3">
    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-2">
                <div>
                    <div class="fw-semibold">Saved teams</div>
                    <div class="text-muted small">Save/load a named set of selected employees (stored in this browser).</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_teamsError))
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@_teamsError</div>
            }

            <div class="row g-2 align-items-end mt-2">
                <div class="col-12 col-md-6">
                    <label class="form-label mb-1">team name</label>
                    <input class="form-control" @bind="_teamName" placeholder="e.g. Team Alpha" />
                </div>
                <div class="col-12 col-md-auto">
                    <button class="btn btn-primary w-100" type="button" @onclick="SaveOrUpdateTeamAsync">
                        @(_editingTeamId is null ? "Save new" : "Update")
                    </button>
                </div>
                @if (_editingTeamId is not null)
                {
                    <div class="col-12 col-md-auto">
                        <button class="btn btn-outline-secondary w-100" type="button" @onclick="CancelEdit">Cancel</button>
                    </div>
                }
            </div>

            @if (_savedTeams.Count == 0)
            {
                <div class="text-muted small mt-3">No saved teams yet.</div>
            }
            else
            {
                <div class="list-group mt-3">
                    @foreach (var v in _savedTeams)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@v.Name</div>
                                <div class="text-muted small">@v.EmployeeIds.Count employee(s)</div>
                            </div>
                            <div class="btn-group">
                                <button class="btn btn-outline-primary btn-sm" type="button" @onclick="() => LoadTeamAsync(v.Id)">Load</button>
                                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => StartEditAsync(v.Id)">Edit</button>
                                <button class="btn btn-outline-danger btn-sm" type="button" @onclick="() => DeleteTeamAsync(v.Id)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <form class="input-group" @onsubmit="OnSearchSubmit" @onsubmit:preventDefault="true">
        <input class="form-control"
               @bind="_query"
               @bind:event="oninput"
               placeholder="Type a name/email..."
               aria-label="Search employees by name or email" />
        <button class="btn btn-primary"
                type="submit"
                disabled="@_isLoading">
            Search
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger mb-0" role="alert">@_loadError</div>
    }

    @if (_isLoading)
    {
        <div class="text-muted">Loading employees…</div>
    }
    else if (_employees.Count == 0)
    {
        <div class="text-muted">No employees found.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var e in _employees.OrderBy(e => e.LastName).ThenBy(e => e.FirstName))
            {
                var checkedValue = SelectedEmployeeIds.Contains(e.Id);

                <label class="list-group-item d-flex align-items-center gap-2">
                    <input class="form-check-input m-0"
                           type="checkbox"
                           checked="@checkedValue"
                           @onchange="async _ => await ToggleAsync(e.Id)" />
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@e.DisplayName</div>
                        <div class="text-muted small">@e.Email</div>
                    </div>
                    @if (!e.IsActive)
                    {
                        <span class="badge text-bg-warning">Inactive</span>
                    }
                </label>
            }
        </div>
    }
</div>

@code {
    [Parameter] public HashSet<int> SelectedEmployeeIds { get; set; } = new();
    [Parameter] public EventCallback<HashSet<int>> SelectedEmployeeIdsChanged { get; set; }

    private string? _query;
    private bool _isLoading;
    private string? _loadError;
    private readonly List<EmployeeDto> _employees = new();

    private readonly List<SavedEmployeeView> _savedTeams = new();
    private string? _teamsError;
    private string? _teamName;
    private string? _editingTeamId;

    protected override async Task OnInitializedAsync()
    {
        await LoadSavedTeamsAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _loadError = null;
        _isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _employees.Clear();
            _employees.AddRange(await EmployeesApi.GetEmployeesAsync(_query));
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSearchSubmit()
        => await RefreshAsync();

    private async Task LoadSavedTeamsAsync()
    {
        _teamsError = null;
        try
        {
            _savedTeams.Clear();
            _savedTeams.AddRange(await ViewsStore.GetAllAsync());
        }
        catch (Exception ex)
        {
            _teamsError = ex.Message;
        }
    }

    private void CancelEdit()
    {
        _editingTeamId = null;
        _teamName = null;
    }

    private static string NormalizeName(string? name)
        => (name ?? "").Trim();

    private bool IsDuplicateName(string name, string? excludingId)
        => _savedTeams.Any(v =>
            !string.Equals(v.Id, excludingId, StringComparison.Ordinal) &&
            string.Equals(v.Name.Trim(), name, StringComparison.OrdinalIgnoreCase));

    private async Task SaveOrUpdateTeamAsync()
    {
        _teamsError = null;

        var name = NormalizeName(_teamName);
        if (string.IsNullOrWhiteSpace(name))
        {
            _teamsError = "Please enter a team name.";
            return;
        }

        if (IsDuplicateName(name, _editingTeamId))
        {
            _teamsError = "A team with this name already exists.";
            return;
        }

        var team = _editingTeamId is null
            ? new SavedEmployeeView()
            : (await ViewsStore.GetByIdAsync(_editingTeamId) ?? new SavedEmployeeView { Id = _editingTeamId });

        team.Name = name;
        team.EmployeeIds = SelectedEmployeeIds.OrderBy(x => x).ToList();
        team.UpdatedUtc = DateTimeOffset.UtcNow;

        try
        {
            await ViewsStore.UpsertAsync(team);
            await LoadSavedTeamsAsync();
            _editingTeamId = team.Id;
        }
        catch (Exception ex)
        {
            _teamsError = ex.Message;
        }
    }

    private async Task LoadTeamAsync(string id)
    {
        _teamsError = null;
        try
        {
            var team = await ViewsStore.GetByIdAsync(id);
            if (team is null)
            {
                _teamsError = "View not found (it may have been deleted).";
                await LoadSavedTeamsAsync();
                return;
            }

            await SetSelectedIdsAsync(new HashSet<int>(team.EmployeeIds));
        }
        catch (Exception ex)
        {
            _teamsError = ex.Message;
        }
    }

    private async Task StartEditAsync(string id)
    {
        _teamsError = null;
        try
        {
            var team = await ViewsStore.GetByIdAsync(id);
            if (team is null)
            {
                _teamsError = "Team not found (it may have been deleted).";
                await LoadSavedTeamsAsync();
                return;
            }

            _editingTeamId = team.Id;
            _teamName = team.Name;
            await SetSelectedIdsAsync(new HashSet<int>(team.EmployeeIds));
        }
        catch (Exception ex)
        {
            _teamsError = ex.Message;
        }
    }

    private async Task DeleteTeamAsync(string id)
    {
        _teamsError = null;
        try
        {
            var team = await ViewsStore.GetByIdAsync(id);
            if (team is not null)
            {
                var ok = await Js.InvokeAsync<bool>("confirm", $"Delete team '{team.Name}'?");
                if (!ok)
                {
                    return;
                }
            }

            await ViewsStore.DeleteAsync(id);
            await LoadSavedTeamsAsync();

            if (string.Equals(_editingTeamId, id, StringComparison.Ordinal))
            {
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            _teamsError = ex.Message;
        }
    }

    private async Task SetSelectedIdsAsync(HashSet<int> next)
    {
        SelectedEmployeeIds = next;
        await SelectedEmployeeIdsChanged.InvokeAsync(next);
    }

    private async Task ToggleAsync(int employeeId)
    {
        var next = new HashSet<int>(SelectedEmployeeIds);
        if (!next.Add(employeeId))
        {
            next.Remove(employeeId);
        }

        SelectedEmployeeIds = next;
        await SelectedEmployeeIdsChanged.InvokeAsync(next);
    }
}
