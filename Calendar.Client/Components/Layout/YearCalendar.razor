@using System.Globalization
@inject Services.EmployeeHolidayApiClient EmployeeHolidayApi

<div class="year-calendar">
    <div class="year-header">
        <button class="nav" @onclick="() => ChangeYear(-1)">‹</button>
        <div class="year-title">@DisplayYear</div>
        <button class="nav" @onclick="() => ChangeYear(1)">›</button>
    </div>

    <div class="months-grid">
        @for (int month = 1; month <= 12; month++)
        {
            <div class="month">
                <div class="month-name">@CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</div>
                <table class="month-table">
                    <thead>
                        <tr>
                            @foreach (var d in WeekDayHeaders)
                            {
                                <th>@d</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var week in GetMonthMatrix(DisplayYear, month))
                        {
                            <tr>
                                @foreach (var day in week)
                                {
                                    var css = GetCellClass(day, month);
                                    <td class="@css">
                                        @if (day.Month == month)
                                        {
                                            @day.Day
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Year { get; set; } = DateTime.Today.Year;

    // Parent supplies this. When it changes the component will re-fetch.
    [Parameter]
    public string? EmployeeInitials { get; set; }

    private List<HolidayDto> _holidays = new();
    private DayOfWeek StartOfWeek = DayOfWeek.Monday;
    int DisplayYear { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        DisplayYear = Year;

        // fetch holidays whenever EmployeeInitials or Year (parameter) changes
        await LoadHolidaysAsync();
    }

    async Task ChangeYear(int offset)
    {
        DisplayYear += offset;

        await LoadHolidaysAsync();
    }

    IEnumerable<string> WeekDayHeaders
    {
        get
        {
            var names = CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames;
            for (int i = 0; i < 7; i++)
            {
                var idx = ((int)StartOfWeek + i) % 7;
                yield return names[idx];
            }
        }
    }

    async Task LoadHolidaysAsync()
    {
        if (string.IsNullOrWhiteSpace(EmployeeInitials))
        {
            _holidays = new List<HolidayDto>();
            return;
        }

        try
        {
            _holidays = await EmployeeHolidayApi.GetEmployeeHolidayAsync(EmployeeInitials!, DisplayYear);
            // ensure not null
            _holidays ??= new List<HolidayDto>();
        }
        catch
        {
            // swallow errors in UI component; optionally log if you inject a logger
            _holidays = new List<HolidayDto>();
        }

        // re-render with new holidays
        StateHasChanged();
    }

    List<List<DateTime>> GetMonthMatrix(int year, int month)
    {
        var firstOfMonth = new DateTime(year, month, 1);
        int startOffset = ((int)firstOfMonth.DayOfWeek - (int)StartOfWeek + 7) % 7;
        var cellStart = firstOfMonth.AddDays(-startOffset);

        var weeks = new List<List<DateTime>>(6);
        var cursor = cellStart;
        for (int r = 0; r < 6; r++)
        {
            var week = new List<DateTime>(7);
            for (int c = 0; c < 7; c++)
            {
                week.Add(cursor);
                cursor = cursor.AddDays(1);
            }
            weeks.Add(week);
        }
        return weeks;
    }

    string GetCellClass(DateTime day, int month)
    {
        // Do not apply today/holiday classes to days outside the current month.
        if (day.Month != month)
        {
            return "";
        }

        var classes = new List<string>();
        if (day.Date == DateTime.Today) classes.Add("today");

        if (_holidays != null && _holidays.Count > 0)
        {
            var holiday = _holidays.FirstOrDefault(o => o.HolidayDate.Date == day.Date);

            if (holiday != null)
            {
                classes.Add("holiday");

                if (holiday.HolidaySize == 0.5m)
                {
                    classes.Add("half-day");
                }

                if (holiday.HolidayType == 2)
                {
                    classes.Add("sick-leave");
                }
                else if (holiday.HolidayType == 3)
                {
                    classes.Add("public-holiday");
                }
            }
        }

        return string.Join(" ", classes);
    }
}